<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.DengjiyuanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.DengjiyuanEntity" id="dengjiyuanMap">
        <result property="dengjizhanghao" column="dengjizhanghao"/>
        <result property="mima" column="mima"/>
        <result property="dengjiyuan" column="dengjiyuan"/>
        <result property="xingbie" column="xingbie"/>
        <result property="touxiang" column="touxiang"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.DengjiyuanView" >

		SELECT  dengjiyuan.* FROM dengjiyuan  dengjiyuan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.DengjiyuanView" >
		SELECT * FROM dengjiyuan  dengjiyuan <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
