    <select id="selectListView"
		resultType="com.cl.entity.view.FeiwucunchuView" >

		SELECT  feiwucunchu.* FROM feiwucunchu  feiwucunchu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
