        <result property="chuzhizhanghao" column="chuzhizhanghao"/>
        <result property="chuzhiyuan" column="chuzhiyuan"/>
        <result property="feiwumingcheng" column="feiwumingcheng"/>
        <result property="feiwuleibie" column="feiwuleibie"/>
        <result property="cunchudidian" column="cunchudidian"/>
        <result property="cunchushijian" column="cunchushijian"/>
        <result property="zhuanyunzhanghao" column="zhuanyunzhanghao"/>
